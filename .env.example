# Configuración de Entorno para Agente ANPR (Edge 2026)

# Credenciales de Supabase
SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_KEY="tu-service-role-key-aqui"

# UUID de la sucursal (requerido para asociar registros y Storage)
DEFAULT_SUCURSAL_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Edge Function / Webhook Cloud que procesa capturas con Gemini OCR
WEBHOOK_URL="https://tu-proyecto.supabase.co/functions/v1/process-anpr"

# ID de la cámara actual
CAMERA_ID="camara_puerta_principal"

# --- CONFIGURACIÓN DE CÁMARA IP DAHUA ---
# DAHUA_HOST="192.168.1.34"
# DAHUA_PORT="80"
# DAHUA_RTSP_PORT="554"
# DAHUA_CHANNEL="1"
# DAHUA_USER="admin"
# DAHUA_PASS="tu-clave"
# CAMERA_SOURCE="rtsp://admin:tu-clave@192.168.1.34:554/cam/realmonitor?channel=1&subtype=1"

# --- INTELIGENCIA ARTIFICIAL Y MODELO ---
# Modelo nano: en CPU sin GPU yolo11s tardaba ~1,6 s/frame (auditoría 2026-09-28);
# yolov8n ~0,15 s. Para más velocidad en CPU Intel: exportar a OpenVINO.
YOLO_MODEL="yolov8n.pt"
YOLO_TRACKER="botsort.yaml"
YOLO_CONFIDENCE="0.40"
YOLO_IMGSZ="320"
PROCESS_EVERY_N_FRAMES="1"

# --- MOTOR BIDIRECCIONAL (PUERTA ÚNICA) ---
# Cámara DENTRO del garaje apuntando a la calle. Se usa el borde inferior del bbox:
#   y < Línea B          → CALLE (tráfico / estacionados: se ignora)
#   Línea B ≤ y < Línea A → PORTAL (vereda/portón)
#   y ≥ Línea A          → INTERIOR (rampa)
# La dirección sale de la trayectoria: hacia la cámara = ENTRADA, alejándose = SALIDA.
ROI_LINE_A_Y_RATIO="0.68"
ROI_LINE_B_Y_RATIO="0.56"
ROI_DIRECTION_TIMEOUT_SEC="8.0"
ROI_TRACK_LOST_SEC="3.5"
ROI_MIN_DISPLACEMENT_RATIO="0.04"
ROI_CONTINUATION_SEC="8.0"
ROI_EVENT_HOLD_SEC="1.5"
# ROI_POLYGON_RATIOS="0,0.3,0.7,0.3,0.7,1,0,1"   # opcional, coords 0..1

# --- CALIDAD ÓPTICA Y CONTROL DE LUZ ---
MIN_BLUR_THRESHOLD="60.0"
MIN_CROP_WIDTH="200"
MIN_CROP_HEIGHT="150"
MIN_BBOX_AREA="15000"
FRAME_BUFFER_SIZE="8"
CROP_MARGIN_PX="20"
# Recortes por evento enviados al OCR (lectura multi-frame anti-alucinación)
CROPS_PER_EVENT="3"

# --- ANTI-FLOOD Y COOLDOWN ---
COOLDOWN_PER_PLATE_SEC="45"
MAX_PROCESSED_IDS_TTL="300"
MAX_ACTIVE_TRACKS="20"

# --- OPTIMIZACIÓN Y THREADING ---
USE_THREADING="true"
USE_MOG2_PREFILTER="true"
MOG2_MOTION_THRESHOLD="0.005"

# --- INTERFAZ Y LOGS ---
# Ventana de visualización (consume CPU; desactivar en producción)
SHOW_DISPLAY="false"
DISPLAY_WIDTH="960"
LOG_LEVEL="INFO"

# --- CÁMARA ---
# 0 = sin reconexión preventiva (cada reconexión deja ~5 s sin video)
PROACTIVE_RECONNECT_SEC="0"
CAMERA_OPEN_TIMEOUT_MS="8000"
CAMERA_READ_TIMEOUT_MS="8000"

# --- MANTENIMIENTO ---
# Consulta liviana a Supabase cada 6 h: evita que el plan gratuito pause el proyecto
HEARTBEAT_SEC="21600"

# Latido al panel cada 60 s (estado de la cámara y de la cola). 0 = desactivado
AGENT_STATUS_SEC="60"

# Secreto compartido con la Edge Function process-anpr (header x-agent-secret).
# Debe ser IGUAL al secret ANPR_AGENT_SECRET configurado en Supabase. Generarlo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ANPR_AGENT_SECRET=""

# --- RESILIENCIA OFFLINE (SQLITE) ---
OFFLINE_QUEUE_DB="offline_queue.db"
OFFLINE_RETRY_SEC="15.0"
OFFLINE_MAX_RETRIES="500"

# --- LECTURA LOCAL DE PATENTES (segunda opinión de Gemini) ---
# Detector de patente + OCR en el portón; vota entre cuadros y manda a la nube la patente ampliada.
# La Edge Function acepta la patente sola si ambos lectores coinciden. false = comportamiento anterior.
PLATE_READER_ENABLED="true"
PLATE_DETECTOR_MODEL="yolo-v9-t-384-license-plate-end2end"
PLATE_OCR_MODEL="cct-s-v2-global-model"
PLATE_CROPS_PER_EVENT="2"

# --- DOS STREAMS Y RENDIMIENTO ---
# Los valores por defecto se adaptan solos al equipo: NO hace falta tocarlos en la mini PC.
# Detección (YOLO + tracker) en el sub-stream; recortes de patente del stream principal.
DUAL_STREAM="true"
# CAMERA_SOURCE_DETECT=""            # vacío = CAMERA_SOURCE con subtype=1
# Stream principal: auto = todos los cuadros si el equipo los decodifica a tiempo; si no, keyframes
MAIN_DECODE_MODE="auto"
# Tope de inferencias YOLO por segundo. 0 = sin tope (lo que dé el equipo)
DETECT_MAX_FPS="0"
# Hilos del lector de patentes. 0 = automático (1 con ≤ 2 núcleos, la mitad con más)
PLATE_READER_THREADS="0"
YOLO_TRACKER="bytetrack.yaml"
# Con hardware sobrado (mini PC) se puede subir la resolución de detección: YOLO_IMGSZ="640"
#
# Perfil de PRUEBA (Pentium B980, 2 núcleos): no requiere cambios; el modo auto pasa solo a
# keyframes. Opcional: DETECT_MAX_FPS="5" y MAIN_DECODE_MODE="keyframes" para arrancar directo así.

# --- AVISOS SOLO POR MOVIMIENTO ---
# true: solo genera evento un vehículo que CRUZA las líneas del portón o que se movió claramente hacia la
# entrada o la salida. Un objeto que se queda quieto y desaparece (p. ej. un auto estacionado afuera visto a
# través de la reja, que el seguimiento pierde y re-detecta) ya no avisa "sin dirección". false = comportamiento anterior.
# REGLA ESTRICTA DEL PORTÓN (principal): solo el cruce de línea genera aviso. ENTRADA = estuvo arriba de la línea B
# y llegó a la A; SALIDA = estuvo abajo de la A y llegó a la B. Lo que no cruza se archiva con su foto en quietos.db
# (no va al panel). "sombra" = marca lo que archivaría pero envía todo (para probar). "false" = comportamiento anterior.
ROI_SOLO_CRUCES="false"
# Segundos para unir un seguimiento cortado a mitad del portón (mismo vehículo con otro ID)
ROI_UNION_SEC="3.0"
ROI_SOLO_MOVIMIENTO="false"
# Avisos iguales previos (mismo lugar, sin patente, no moto) para suprimir un objeto que no cruzó ninguna línea.
# 5 = solo lugares repetidos (por defecto). 0 = sin cruce de línea no hay aviso (con patente o moto, igual se envía).
QUIETOS_MIN_REPETICIONES="5"

# --- AVISOS REPETIDOS DEL MISMO VEHICULO ---
# Un auto parado o maniobrando en la puerta se pierde de vista y se re-detecta, y cada vez avisa. Con "true", un aviso
# no se envia como nuevo solo si: misma patente leida con firmeza (2+ cuadros), mismo sentido, hace menos de 10 min
# del aviso anterior y no pasaron 60 min desde el ultimo enviado. Un sentido contrario SIEMPRE se envia. Nada se borra
# (queda en la carpeta repetidos/ y en quietos.db). "sombra" = marca lo que agruparia pero ENVIA TODO. "false" = como antes.
ROI_AGRUPAR_REPETIDOS="false"
